{
  "name": "sicklecare-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for SickleCare Firebase Backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "axios": "^1.5.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "googleapis": "^127.0.0",
    "helmet": "^7.0.0",
    "moment": "^2.29.4",
    "pdfkit": "^0.14.0",
    "stripe": "^14.11.0",
    "twilio": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "@grpc/grpc-js": "^1.13.6",
    "fast-xml-parser": "^5.12.1",
    "protobufjs": "^7.6.3",
    "protobufjs-cli": "^1.3.3"
  },
  "private": true
}
