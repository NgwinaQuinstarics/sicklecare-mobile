{
  "name": "sicklecare-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for SickleCare Firebase Backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "npm run build && node --test test/sika-validation.test.js",
    "test:watch": "node --test --watch test/sika-validation.test.js"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "axios": "^1.5.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "googleapis": "^127.0.0",
    "helmet": "^7.0.0",
    "moment": "^2.29.4",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "stripe": "^14.11.0",
    "twilio": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-google": "^0.14.0",
    "typescript": "^5.2.2"
  },
  "private": true
}
