rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    function isDoctor() {
      return request.auth.token.doctor == true;
    }
    
    function isValidUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isPatient() {
      return getUserRole() == 'patient';
    }
    
    function isCaregiver() {
      return getUserRole() == 'caregiver';
    }
    
    function isValidHealthData() {
      // Validate health data structure
      return request.resource.data.hydration is number
        && request.resource.data.hydration >= 0
        && request.resource.data.hydration <= 10
        && request.resource.data.painLevel is number
        && request.resource.data.painLevel >= 0
        && request.resource.data.painLevel <= 10
        && request.resource.data.meals is list
        && request.resource.data.timestamp is timestamp;
    }
    
    // Users collection - users can manage their own profile
    match /users/{userId} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor());
      allow write: if isSignedIn() && isUser(userId);
      
      // User profile subcollection
      match /profile/{documentId} {
        allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor());
        allow write: if isSignedIn() && isUser(userId);
      }
      
      // Health data subcollection
      match /health/{date} {
        allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor() || isCaregiver());
        allow create: if isSignedIn() && isUser(userId) && isValidHealthData();
        allow update, delete: if isSignedIn() && isUser(userId);
      }
      
      // Reminders subcollection
      match /reminders/{reminderId} {
        allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor() || isCaregiver());
        allow write: if isSignedIn() && isUser(userId);
      }
      
      // Settings subcollection
      match /settings/{documentId} {
        allow read, write: if isSignedIn() && isUser(userId);
      }
    }
    
    // Support tickets collection
    match /support/{ticketId} {
      allow read: if isSignedIn() && (
        // Users can read their own tickets
        request.resource.data.userId == request.auth.uid ||
        // Admins can read all tickets
        isAdmin() ||
        // Support staff can read tickets
        request.auth.token.support == true
      );
      
      allow create: if isSignedIn() && isValidUser();
      
      allow update: if isSignedIn() && (
        // Users can update their own tickets
        resource.data.userId == request.auth.uid ||
        // Admins and support can update any ticket
        isAdmin() || request.auth.token.support == true
      );
    }
    
    // Analytics collection (aggregated data)
    match /analytics/{userId} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor());
      allow write: if isAdmin(); // Only admins can write analytics
    }
    
    // System-wide collections
    match /system/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Public data (read-only for all authenticated users)
    match /public/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Notifications collection
    match /notifications/{userId}/{notificationId} {
      allow read: if isSignedIn() && isUser(userId);
      allow write: if isAdmin() || request.auth.token.system == true;
    }
    
    // Rate limiting: Max 100 writes per minute per user
    function rateLimit() {
      return request.time > resource.data.lastWrite.toMillis() + 60000;
    }
    
    // Apply rate limiting to health data writes
    match /users/{userId}/health/{date} {
      allow write: if isSignedIn() && isUser(userId) && rateLimit();
    }
  }
}