rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isSupport() {
      return isSignedIn() && request.auth.token.support == true;
    }

    function validUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'displayName', 'photoURL', 'role',
          'createdAt', 'updatedAt', 'settings', 'healthStats',
          'genotype', 'phone'
        ])
        && (!('uid' in request.resource.data)
          || request.resource.data.uid == userId)
        && (!('email' in request.resource.data)
          || request.resource.data.email == request.auth.token.email)
        && (!('role' in request.resource.data)
          || request.resource.data.role in ['user', 'patient'])
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string
            && request.resource.data.name.size() <= 120))
        && (!('createdAt' in request.resource.data)
          || request.resource.data.createdAt == request.time);
    }

    function validUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'name', 'displayName', 'photoURL', 'settings', 'genotype',
          'phone', 'updatedAt'
        ])
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string
            && request.resource.data.name.size() <= 120))
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 120))
        && (!('photoURL' in request.resource.data)
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048))
        && (!('settings' in request.resource.data)
          || request.resource.data.settings is map)
        && (!('genotype' in request.resource.data)
          || (request.resource.data.genotype is string
            && request.resource.data.genotype.size() <= 40))
        && (!('phone' in request.resource.data)
          || (request.resource.data.phone is string
            && request.resource.data.phone.size() <= 40))
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp);
    }

    function validHealthEntry(userId) {
      return request.resource.data.keys().hasOnly([
          'userId', 'painLevel', 'hydration', 'timestamp', 'meals',
          'medications', 'notes'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.painLevel is number
        && request.resource.data.painLevel >= 0
        && request.resource.data.painLevel <= 10
        && request.resource.data.hydration is number
        && request.resource.data.hydration >= 0
        && request.resource.data.hydration <= 10
        && request.resource.data.timestamp is timestamp
        && (!('meals' in request.resource.data)
          || request.resource.data.meals is list)
        && (!('medications' in request.resource.data)
          || request.resource.data.medications is list)
        && (!('notes' in request.resource.data)
          || (request.resource.data.notes is string
            && request.resource.data.notes.size() <= 2000));
    }

    function validTrackerEntry(entryId) {
      return request.resource.data.keys().hasOnly([
          'id', 'date', 'painLevel', 'hydrationMl', 'mood', 'notes'
        ])
        && request.resource.data.id == entryId
        && request.resource.data.id.size() <= 128
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 32
        && request.resource.data.painLevel is int
        && request.resource.data.painLevel >= 0
        && request.resource.data.painLevel <= 10
        && request.resource.data.hydrationMl is int
        && request.resource.data.hydrationMl >= 0
        && request.resource.data.hydrationMl <= 10000
        && request.resource.data.mood is string
        && request.resource.data.mood.size() <= 32
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000;
    }

    function validReminder(userId) {
      return request.resource.data.keys().hasOnly([
          'userId', 'title', 'type', 'time', 'repeat', 'active',
          'completed', 'createdAt', 'updatedAt', 'nextNotificationTime'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.type in [
          'medication', 'hydration', 'appointment', 'checkup'
        ]
        && request.resource.data.time is timestamp
        && request.resource.data.repeat in ['once', 'daily', 'weekly', 'monthly']
        && request.resource.data.active is bool
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.nextNotificationTime is timestamp;
    }

    function validContactPayload() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'status', 'source',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2500
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'mobile_support'
        && request.resource.data.createdAt == request.time;
    }

    function validSupportMessage() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'status', 'source',
          'createdAt', 'uid', 'userEmail', 'userName'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2500
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'mobile_support'
        && request.resource.data.createdAt == request.time
        && (!('userEmail' in request.resource.data)
          || request.resource.data.userEmail == null
          || request.resource.data.userEmail == request.auth.token.email)
        && (!('userName' in request.resource.data)
          || request.resource.data.userName == null
          || (request.resource.data.userName is string
            && request.resource.data.userName.size() <= 120));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserCreate(userId);
      allow update: if isOwner(userId) && validUserUpdate();
      allow delete: if isAdmin();

      match /profile/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /health/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update:
          if isOwner(userId) && validHealthEntry(userId);
      }

      match /tracker_entries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update:
          if isOwner(userId) && validTrackerEntry(entryId);
      }

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && validReminder(userId)
          && request.resource.data.time >= request.time;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'title', 'type', 'time', 'repeat', 'active', 'completed',
              'updatedAt', 'nextNotificationTime'
            ])
          && validReminder(userId)
          && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['time'])
            || request.resource.data.time >= request.time);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      match /reports/{reportId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /support/{ticketId} {
      allow read: if isAdmin() || isSupport()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2500
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || isSupport()
        || (isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['message'])
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 2500);
      allow delete: if isAdmin() || isSupport();
    }

    match /support_messages/{messageId} {
      allow create: if isSignedIn() && validSupportMessage();
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if validContactPayload();
      allow read, update, delete: if isAdmin();
    }

    match /analytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /system/{document=**} {
      allow read, write: if isAdmin();
    }

    match /public/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{userId}/history/{notificationId} {
      allow read: if isOwner(userId);
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /content/{contentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
