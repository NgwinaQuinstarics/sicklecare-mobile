rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    function isDoctor() {
      return request.auth.token.doctor == true;
    }
    
    function isValidFileType() {
      return request.resource.contentType.matches('image/.*') 
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('text/.*');
    }
    
    function isValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    // User profiles - profile pictures
    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor());
      allow write: if isSignedIn() && isUser(userId) && isValidFileType() && isValidFileSize();
      allow delete: if isSignedIn() && isUser(userId);
    }
    
    // Health documents - medical records, prescriptions, etc.
    match /users/{userId}/health/{documentId}/{fileName} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor());
      allow write: if isSignedIn() && isUser(userId) && isValidFileType() && isValidFileSize();
      allow delete: if isSignedIn() && isUser(userId);
    }
    
    // Reports - generated health reports
    match /users/{userId}/reports/{reportId}/{fileName} {
      allow read: if isSignedIn() && (isUser(userId) || isAdmin() || isDoctor());
      allow write: if isAdmin(); // Only admins/system can write reports
      allow delete: if isSignedIn() && (isUser(userId) || isAdmin());
    }
    
    // App assets - public app assets (logos, icons, etc.)
    match /public/{allPaths=**} {
      allow read: if true; // Public access
      allow write: if isAdmin(); // Only admins can update app assets
    }
    
    // Temporary uploads - for processing
    match /temp/{userId}/{uploadId}/{fileName} {
      allow read: if isSignedIn() && isUser(userId);
      allow write: if isSignedIn() && isUser(userId) && isValidFileType() && isValidFileSize();
      allow delete: if isSignedIn() && isUser(userId) 
        || request.time > resource.metadata.createdAt + duration.value(1, 'h'); // Auto-delete after 1 hour
    }
    
    // Support attachments
    match /support/{ticketId}/{fileName} {
      allow read: if isSignedIn() && (
        // Users can read attachments from their own tickets
        resource.metadata.userId == request.auth.uid ||
        // Admins and support can read all attachments
        isAdmin() || request.auth.token.support == true
      );
      allow write: if isSignedIn() && isValidFileType() && isValidFileSize();
      allow delete: if isAdmin() || request.auth.token.support == true;
    }
    
    // Rate limiting: Max 5 uploads per minute per user
    function rateLimit() {
      return request.time > resource.metadata.lastUpload.toMillis() + 60000;
    }
    
    // Apply rate limiting to user uploads
    match /users/{userId}/{allPaths=**} {
      allow write: if isSignedIn() && isUser(userId) && rateLimit();
    }
  }
}