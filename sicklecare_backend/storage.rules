rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isHealthDocument() {
      return isImage()
        || request.resource.contentType == 'application/pdf';
    }

    function isWithinSizeLimit(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    function canUploadDoctorCredential(userId, fileName) {
      let application = firestore.get(
        /databases/(default)/documents/doctor_applications/$(userId)
      ).data;
      return application.status == 'upload_required'
        && application.credentialUploadPath
          == 'doctor_credentials/' + userId + '/' + fileName;
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update:
        if isOwner(userId)
          && isImage()
          && isWithinSizeLimit(5 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/health/{documentId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update:
        if isOwner(userId)
          && isHealthDocument()
          && isWithinSizeLimit(10 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/reports/{reportId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update:
        if isAdmin()
          && isHealthDocument()
          && isWithinSizeLimit(10 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update:
        if isAdmin()
          && isImage()
          && isWithinSizeLimit(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /temp/{userId}/{uploadId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update:
        if isOwner(userId)
          && isHealthDocument()
          && isWithinSizeLimit(10 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /support/{ticketId}/{fileName} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.token.support == true);
      allow create, update:
        if (isAdmin()
            || (isSignedIn() && request.auth.token.support == true))
          && isHealthDocument()
          && isWithinSizeLimit(10 * 1024 * 1024);
      allow delete: if isAdmin()
        || (isSignedIn() && request.auth.token.support == true);
    }

    match /doctor_credentials/{userId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.contentType.matches(
          'application/pdf|image/(jpeg|png|webp)'
        )
        && request.resource.size > 0
        && isWithinSizeLimit(10 * 1024 * 1024)
        && canUploadDoctorCredential(userId, fileName);
      allow delete: if false;
    }
  }
}
